enum MailTemplateType {
  SIGNATURE_REQUEST
  VERIFICATION_CODE
  INVOICE
  /// @deprecated use PAYMENT instead
  RECEIPT
  PAYMENT
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  EXPIRED
  REJECTED
}

enum InvoiceStatus {
  PAID
  UNPAID
  OVERDUE
  SENT
  DRAFT
  ARCHIVED
}

enum NoteType {
  CREDIT
  DEBIT
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  QUADMONTHLY
  SEMIANNUALLY
  ANNUALLY
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum ItemType {
  HOUR
  DAY
  DEPOSIT
  SERVICE
  PRODUCT
}

enum PaymentMethodType {
  BANK_TRANSFER
  PAYPAL
  CASH
  CHECK
  OTHER
}

enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
}

enum PdfDocumentType {
  QUOTE
  INVOICE
}

enum PluginType {
  SIGNING
  STORAGE
}

enum WebhookEvent {
  QUOTE_CREATED
  QUOTE_UPDATED
  QUOTE_DELETED
  QUOTE_SENT
  QUOTE_SIGNED
  QUOTE_EXPIRED
  QUOTE_REJECTED
  QUOTE_VIEWED
  QUOTE_MARKED_AS_SIGNED
  QUOTE_PDF_GENERATED
  QUOTE_SEARCHED
  QUOTE_STATUS_CHANGED
  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_DELETED
  INVOICE_SENT
  INVOICE_PAID
  INVOICE_OVERDUE
  INVOICE_MARKED_AS_PAID
  INVOICE_PDF_GENERATED
  INVOICE_XML_DOWNLOADED
  INVOICE_CREATED_FROM_QUOTE
  INVOICE_SEARCHED
  INVOICE_STATUS_CHANGED
  RECEIPT_CREATED
  RECEIPT_UPDATED
  RECEIPT_DELETED
  RECEIPT_SENT
  RECEIPT_PDF_GENERATED
  RECEIPT_CREATED_FROM_INVOICE
  RECEIPT_SEARCHED
  PAYMENT_RECEIVED
  PAYMENT_METHOD_CREATED
